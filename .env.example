# Copy this file to .env (`cp .env.example .env`) and fill in real values.
# .env is gitignored; this example file is committed so everyone knows which settings exist.

# --- Database container (used by docker-compose.yml) ---
# The app database itself ("mahub") is created by `dbmate create`, not by the container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
# Port on your laptop that forwards to Postgres inside the container.
# Change it if something else already uses 5432.
DB_PORT=5432

# --- dbmate (migrations) ---
# dbmate reads DATABASE_URL from .env automatically.
# sslmode=disable is fine locally; the connection never leaves your laptop.
DATABASE_URL=postgres://postgres:change-me-local-only@localhost:5432/mahub?sslmode=disable
DBMATE_MIGRATIONS_DIR=./db/migrations
DBMATE_SCHEMA_FILE=./db/schema.sql

# --- API (api/) ---
# Port for the API on your laptop, both for `npm run dev` and the Compose api service.
# They can't both use it at once: stop one before starting the other.
API_PORT=3000
# How much the API logs: fatal, error, warn, info, debug, trace.
LOG_LEVEL=info
