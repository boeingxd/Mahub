# Copy this file to .env (`cp .env.example .env`) and fill in real values.
# .env is gitignored; this example file is committed so everyone knows which settings exist.

# --- Database container (used by docker-compose.yml) ---
# The app database itself ("mahub") is created by `dbmate create`, not by the container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
# Port on your laptop that forwards to Postgres inside the container.
# Change it if something else already uses 5432.
DB_PORT=5432

# --- dbmate (migrations) ---
# dbmate reads DATABASE_URL from .env automatically.
# sslmode=disable is fine locally; the connection never leaves your laptop.
DATABASE_URL=postgres://postgres:change-me-local-only@localhost:5432/mahub?sslmode=disable

# --- The API's own database user (task Y2) ---
# The API must NOT use the postgres superuser above: superusers skip row-level
# security. It logs in as mahub_api instead (a member of app_rw).
# Pick a password, then create the user once (from api/): npm run db:app-user
APP_DB_PASSWORD=change-me-too
API_DATABASE_URL=postgres://mahub_api:change-me-too@localhost:5432/mahub?sslmode=disable
DBMATE_MIGRATIONS_DIR=./db/migrations
DBMATE_SCHEMA_FILE=./db/schema.sql

# --- API (api/) ---
# Port for `npm run dev` on your laptop (http://localhost:3000).
# In Docker the API isn't published; you reach it through Caddy at https://localhost/api/.
API_PORT=3000
# How much the API logs: fatal, error, warn, info, debug, trace.
LOG_LEVEL=info

# --- Google sign-in (task Y1) ---
# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application).
# Ask Yayikast for the real values through a password manager, never in chat or git.
GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me
# Where Google sends the browser back after login. Must be listed EXACTLY under
# "Authorized redirect URIs" in the Google console.
#   npm run dev:             http://localhost:3000/auth/callback
#   Docker (through Caddy):  https://localhost/api/auth/callback
#   Cloudflare Tunnel:       https://<tunnel address>/api/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
# Docker Compose uses this one instead (default https://localhost/api/auth/callback).
# Set it to the tunnel address when testing on phones.
# DOCKER_GOOGLE_REDIRECT_URI=https://<tunnel address>/api/auth/callback
# Encrypts the login cookie. Generate your own (64 hex characters):
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_KEY=

# --- Caddy (infra/caddy/Caddyfile) ---
# How long browsers remember "HTTPS only" for this site, in seconds.
# Short locally (it affects every port on localhost); 31536000 (1 year) for the demo.
HSTS_MAX_AGE=300
