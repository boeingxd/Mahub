  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one main action on a screen.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Start check-in</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;min-height:var(--tap-target);padding:0 var(--space-5);border:0;border-radius:var(--radius);font:inherit;font-family:var(--font-body);font-size:var(--font-size-md);font-weight:600;cursor:pointer;transition:background-color var(--dur-short) var(--ease-out),opacity var(--dur-short) var(--ease-out),transform var(--dur-short) var(--ease-out)}.ds-btn:active{transform:scale(.98);opacity:.85}.ds-btn:focus-visible{outline:3px solid var(--color-focus);outline-offset:2px}.ds-btn-primary{background:var(--color-primary-fill);color:var(--color-primary-text)}.ds-btn-primary:hover{background:var(--color-primary-fill-hover)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Tinted button for the other actions.",
      "html": "<button class=\"ds-btn-secondary\">Open projector</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;min-height:var(--tap-target);padding:0 var(--space-5);border:0;border-radius:var(--radius);font-family:var(--font-body);font-size:var(--font-size-md);font-weight:600;background:var(--color-primary-wash);color:var(--color-primary);cursor:pointer}.ds-btn-secondary:hover{filter:brightness(.96)}.ds-btn-secondary:focus-visible{outline:3px solid var(--color-focus);outline-offset:2px}"
    },
    {
      "name": "Destructive Button",
      "kind": "button",
      "refersTo": "button-destructive",
      "description": "Red tinted button, always behind a confirm dialog.",
      "html": "<button class=\"ds-btn-destructive\">End session</button>",
      "css": ".ds-btn-destructive{display:inline-flex;align-items:center;min-height:var(--tap-target);padding:0 var(--space-5);border:0;border-radius:var(--radius);font-family:var(--font-body);font-size:var(--font-size-md);font-weight:600;background:var(--color-danger-wash);color:var(--color-danger);cursor:pointer}.ds-btn-destructive:hover{filter:brightness(.96)}.ds-btn-destructive:focus-visible{outline:3px solid var(--color-focus);outline-offset:2px}"
    },
    {
      "name": "Status Badges",
      "kind": "chip",
      "refersTo": "badge-success",
      "description": "Tinted pills; the only way status is shown.",
      "html": "<span class=\"ds-badge ds-s\">Present</span> <span class=\"ds-badge ds-d\">Absent</span> <span class=\"ds-badge ds-n\">Excused</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;min-height:22px;padding:0 var(--space-2);border-radius:var(--radius-pill);font-family:var(--font-body);font-size:var(--font-size-sm);font-weight:600}.ds-s{background:var(--color-success-wash);color:var(--color-success)}.ds-d{background:var(--color-danger-wash);color:var(--color-danger)}.ds-w{background:var(--color-warning-wash);color:var(--color-warning)}.ds-n{background:var(--color-neutral-wash);color:var(--color-neutral)}"
    },
    {
      "name": "Class Pass",
      "kind": "card",
      "refersTo": "pass",
      "description": "Signature component: a class in its Wallet-pass colour.",
      "html": "<article class=\"ds-pass\"><header class=\"ds-pass-top\"><span class=\"ds-pass-code\">ITS332</span><span class=\"ds-pass-badge\">Live</span></header><h2 class=\"ds-pass-title\">Database Systems</h2><p class=\"ds-pass-sub\">Section 1</p><dl class=\"ds-pass-fields\"><div><dt>Enrolled</dt><dd>32</dd></div><div><dt>Room</dt><dd>Sample</dd></div></dl><button class=\"ds-pass-btn\">Start check-in</button></article>",
      "css": ".ds-pass{--pass-bg:var(--pass-teal);display:grid;gap:var(--space-1);max-width:340px;background:var(--pass-bg);color:var(--pass-text);border-radius:var(--radius-pass);padding:var(--space-5);box-shadow:var(--shadow-pass);font-family:var(--font-body)}.ds-pass-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--space-3)}.ds-pass-code{font-size:var(--font-size-subhead);font-weight:600;letter-spacing:.02em}.ds-pass-badge{display:inline-flex;align-items:center;min-height:22px;padding:0 var(--space-2);border-radius:var(--radius-pill);background:var(--pass-button);color:var(--pass-bg);font-size:var(--font-size-sm);font-weight:600}.ds-pass-title{margin:0;font-family:var(--font-display);font-size:var(--font-size-xl);font-weight:700;line-height:1.15}.ds-pass-sub{margin:0;font-size:var(--font-size-subhead)}.ds-pass-fields{display:flex;gap:var(--space-3) var(--space-8);margin:var(--space-4) 0 0;padding-top:var(--space-4);border-top:1px solid var(--pass-rule)}.ds-pass-fields dt{font-size:var(--font-size-xs);font-weight:600;text-transform:uppercase;letter-spacing:.04em}.ds-pass-fields dd{margin:0;font-weight:600;font-variant-numeric:tabular-nums}.ds-pass-btn{margin-top:var(--space-5);width:100%;min-height:var(--tap-target);border:0;border-radius:var(--radius);background:var(--pass-button);color:var(--pass-bg);font:inherit;font-size:var(--font-size-md);font-weight:600;cursor:pointer}.ds-pass-btn:active{transform:scale(.98);opacity:.85}.ds-pass-btn:focus-visible{outline:3px solid var(--pass-text);outline-offset:2px}"
    },
    {
      "name": "Grouped List",
      "kind": "custom",
      "refersTo": "list",
      "description": "iOS Settings-style inset list with header, rows and chevrons.",
      "html": "<section><h2 class=\"ds-gh\">Recent check-ins</h2><ul class=\"ds-list\"><li><a class=\"ds-row\" href=\"#\"><span class=\"ds-dot\"></span><span class=\"ds-txt\"><span>Database Systems</span><span class=\"ds-sub\">Mon 09:00</span></span><span class=\"ds-bdg\">Present</span></a></li><li><a class=\"ds-row\" href=\"#\"><span class=\"ds-dot ds-dot2\"></span><span class=\"ds-txt\"><span>Computer Networks</span><span class=\"ds-sub\">Tue 13:30</span></span><span class=\"ds-bdg\">Present</span></a></li></ul></section>",
      "css": ".ds-gh{font-family:var(--font-body);font-size:var(--font-size-sm);font-weight:400;color:var(--color-text-muted);text-transform:uppercase;letter-spacing:.02em;margin:0 0 var(--space-2) var(--space-4)}.ds-list{list-style:none;margin:0;padding:0;background:var(--color-surface);border-radius:var(--radius);overflow:hidden;font-family:var(--font-body)}.ds-row{display:flex;align-items:center;gap:var(--space-3);min-height:var(--tap-target);padding:var(--space-3) var(--space-4);color:var(--color-text);text-decoration:none;transition:background-color var(--dur-short) var(--ease-out)}.ds-list>li+li .ds-row{box-shadow:inset var(--space-4) 1px 0 var(--color-surface),inset 0 1px 0 var(--color-border)}.ds-row:hover,.ds-row:active{background:var(--color-surface-2)}.ds-row:focus-visible{outline:3px solid var(--color-focus);outline-offset:-3px}.ds-txt{display:grid;flex:1}.ds-sub{font-size:var(--font-size-subhead);color:var(--color-text-muted);font-variant-numeric:tabular-nums}.ds-dot{width:12px;height:12px;border-radius:50%;background:var(--pass-teal)}.ds-dot2{background:var(--pass-indigo)}.ds-bdg{display:inline-flex;align-items:center;min-height:22px;padding:0 var(--space-2);border-radius:var(--radius-pill);font-size:var(--font-size-sm);font-weight:600;background:var(--color-success-wash);color:var(--color-success)}"
    },
    {
      "name": "Segmented Control",
      "kind": "custom",
      "refersTo": null,
      "description": "iOS segmented control; selected segment raised.",
      "html": "<div class=\"ds-seg\"><button class=\"ds-seg-o\" aria-pressed=\"true\">Check-in</button><button class=\"ds-seg-o\" aria-pressed=\"false\">Roster</button></div>",
      "css": ".ds-seg{display:inline-flex;padding:2px;border-radius:9px;background:var(--color-surface-2)}.ds-seg-o{min-height:var(--tap-target);min-width:96px;padding:0 var(--space-4);border:0;border-radius:7px;background:transparent;color:var(--color-text);font-family:var(--font-body);font-size:var(--font-size-subhead);font-weight:500;cursor:pointer;transition:background-color var(--dur-short) var(--ease-out)}.ds-seg-o[aria-pressed=true]{background:var(--color-surface);font-weight:600;box-shadow:var(--shadow-control)}.ds-seg-o:focus-visible{outline:3px solid var(--color-focus);outline-offset:2px}"
    },
    {
      "name": "Student Tab Bar",
      "kind": "nav",
      "refersTo": "tab-bar",
      "description": "Blurred bottom tab bar on student screens.",
      "html": "<nav class=\"ds-tabs\"><a class=\"ds-tab ds-on\" href=\"#\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"3\"/></svg><span>My classes</span></a><a class=\"ds-tab\" href=\"#\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 20V10M12 20V4M19 20v-7\"/></svg><span>Overview</span></a></nav>",
      "css": ".ds-tabs{display:flex;justify-content:center;gap:var(--space-2);background:color-mix(in srgb,var(--color-surface) 82%,transparent);backdrop-filter:saturate(180%) blur(20px);-webkit-backdrop-filter:saturate(180%) blur(20px);border-top:1px solid var(--color-border);font-family:var(--font-body)}.ds-tab{display:grid;justify-items:center;align-content:center;gap:2px;flex:0 1 160px;min-height:var(--tab-bar-height);color:var(--color-text-muted);font-size:11px;font-weight:500;text-decoration:none}.ds-tab svg{width:26px;height:26px}.ds-tab.ds-on{color:var(--color-primary)}.ds-tab:focus-visible{outline:3px solid var(--color-focus);outline-offset:-3px}"
    }
  ],
  "narrative": {
    "northStar": "The Class Pass",
    "overview": "Mahub looks like a stock iPhone app: Apple Wallet for the classes, Settings for everything else. Each class is a coloured pass, and that colour follows the class to every screen: the instructor's home, the live session header, the projector band, the student's result and the colour dots in lists. Everything around the passes is plain: the device's own font, grouped inset lists on a grey ground, and blue as the only interactive colour.\n\nThe screens are quiet and dense enough to scan quickly. There's one main action per screen and one moment of motion (the result pass sliding up). Light and dark follow the device, and the projector is always dark. The CSP forbids `style=\"\"` attributes and external assets, so every visual decision is a class in `src/ui/ui.css` reading a token from `src/ui/tokens.css`.",
    "keyCharacteristics": [
      "One Wallet-pass colour per class, with white text, used for identity only.",
      "Status appears only as small tinted badges (and the two tinted stat numbers).",
      "The system font, iOS text sizes, and tabular digits for every number.",
      "Grouped inset lists (12px) on a grey ground; passes are rounder (20px).",
      "Flat surfaces. Soft shadows only on passes, dialogs and the selected segment."
    ],
    "rules": [
      {
        "name": "The Colour Is Identity Rule",
        "body": "A class colour says *which class*, never *how it went*. No green pass (green means present), and no red or amber pass meaning \"problem\". Status always goes in a Badge.",
        "section": "colors"
      },
      {
        "name": "The One Tint Rule",
        "body": "Blue is the only colour for things you can tap. Don't introduce a second accent.",
        "section": "colors"
      },
      {
        "name": "The Tabular Digits Rule",
        "body": "Every student number, time, count and rate uses tabular digits (`.mono`, or `font-variant-numeric: tabular-nums`), never the monospace font.",
        "section": "typography"
      },
      {
        "name": "The Uppercase Belongs To iOS Rule",
        "body": "Uppercase appears in exactly two places: grouped-list section headers and pass field labels. Don't add uppercase labels above titles anywhere else.",
        "section": "typography"
      },
      {
        "name": "The Flat Lists Rule",
        "body": "Lists, cards, stat tiles and the session board have no shadow. If it isn't a pass, a dialog or a selected segment, it's flat.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** give a class its `pass-<colour>` class once on the container and let `--pass-bg` colour everything inside it.",
      "**Do** show attendance status with `Badge` (success / danger / warning / neutral) and nothing else.",
      "**Do** put tabular digits on every number (`.mono`).",
      "**Do** keep every tap target at least 44px (`--tap-target`).",
      "**Do** use one primary button per screen. On phones, make it `button-block`.",
      "**Do** take every colour, size and space from `tokens.css`, and style with classes in `ui.css`. The CSP blocks `style=\"\"`.",
      "**Do** check new colour pairs for 4.5:1 contrast in both light and dark.",
      "**Do** keep the QR on pure white with a wide quiet zone, in both modes."
    ],
    "donts": [
      "**Don't** use a class colour to mean status, and don't add a green pass colour.",
      "**Don't** add a second accent colour, web fonts, or any asset from another origin.",
      "**Don't** put shadows on lists, cards or stat tiles, or use blur anywhere except the app bar and tab bar.",
      "**Don't** add animations beyond `pass-enter`. Other changes are 150ms state transitions, and reduced motion must be respected.",
      "**Don't** add a light/dark toggle (the app follows the device), and don't let the projector go light.",
      "**Don't** add uppercase labels above titles. Uppercase is only for list section headers and pass field labels.",
      "**Don't** use emoji or icon fonts for icons. Add a 24×24 stroked SVG to `icons.tsx`."
    ]
  }
}