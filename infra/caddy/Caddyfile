# Caddy is our edge server: the only thing reachable from outside Docker.
# Every request from a browser arrives here first, over HTTPS, and Caddy
# forwards it to the right service inside the Compose network.
# See docs/NETWORK.md for the full picture.
{
	# Caddy would normally try to add its local certificate authority to the
	# trust store of the machine it runs on. Inside a container that's
	# pointless (your Mac is what needs to trust it; see docs/NETWORK.md).
	skip_install_trust

	# The real visitor's address, for the :8080 door below (the tunnel).
	# Cloudflare puts it in the CF-Connecting-IP header, but anyone can send a
	# header like that, so Caddy believes it ONLY when the request comes from
	# the tunnel container (the fixed address set in docker-compose.yml).
	# From anyone else the header is ignored and {client_ip} is the real
	# connection address.
	servers :8080 {
		trusted_proxies static 172.28.1.10/32
		client_ip_headers CF-Connecting-IP
	}
}

# Everything the site does, written once and used by both doors below.
(routes) {
	# Security headers, added to every response.
	header {
		# HSTS: "only ever use HTTPS for this site". The browser remembers it
		# for max-age seconds. Short by default, because on localhost it also
		# affects your other local projects; the demo can raise it.
		Strict-Transport-Security "max-age={$HSTS_MAX_AGE:300}"
		# CSP: only load scripts, styles, images, etc. from our own site.
		# No inline scripts, so an injected <script> tag won't run.
		# data: images are allowed for the QR code. frame-ancestors 'none'
		# stops other sites from showing us inside an invisible frame.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# Don't let the browser guess a file's type (e.g. run a .txt as script).
		X-Content-Type-Options "nosniff"
		# When following a link to another site, send only our origin, not the full URL.
		Referrer-Policy "strict-origin-when-cross-origin"
		# Which device features pages may ask for. Only our own pages may ask
		# for location (the check-in page needs it); camera and mic: nobody.
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		# Don't advertise which server software we run.
		-Server
	}

	# A fresh ID for every request. It replaces any X-Request-Id the client
	# sent (clients can't choose it), and the API logs it on every line.
	request_header X-Request-Id {http.request.uuid}

	# /api/* → the API. handle_path strips the /api prefix, so the API's own
	# routes stay short: https://localhost/api/healthz reaches GET /healthz.
	handle_path /api/* {
		reverse_proxy api:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# QR scan links (task Y3) and the live roster WebSocket (task B5) also go
	# to the API, with their paths unchanged.
	handle /c/* {
		reverse_proxy api:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle /ws {
		reverse_proxy api:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Everything else is the React web app: plain files built by Vite into /srv.
	# Built JS/CSS files live in /assets/. A missing one must be a real 404
	# (not index.html), or a browser with an old page open gets HTML instead
	# of JavaScript and breaks in a confusing way.
	handle /assets/* {
		root * /srv
		file_server
	}
	handle {
		root * /srv
		# The app has its own pages (/instructor, /checkin, ...) that exist only
		# inside React, not as files. If no file matches the path, send
		# index.html and let React show the right page. Without this, reloading
		# /instructor would be a 404.
		try_files {path} /index.html
		file_server
	}
}

# Door 1: your browser on the laptop, over HTTPS.
localhost {
	# "internal" = Caddy acts as its own small certificate authority and
	# issues a certificate for localhost. (Real domains would get one from
	# Let's Encrypt automatically.) Plain http://localhost is redirected here.
	tls internal

	import routes
}

# Door 2: the Cloudflare Tunnel (task B4). Plain HTTP on purpose: HTTPS ends at
# Cloudflare, and this port is not published, so it only exists inside Docker
# (the tunnel container reaches it as http://caddy:8080).
:8080 {
	import routes
}
